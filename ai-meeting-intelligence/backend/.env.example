# Database Configuration
# PostgreSQL (default in Docker): postgresql+asyncpg://postgres:postgres@localhost:5432/meeting_intelligence
# SQLite fallback (default in local development without PG): sqlite+aiosqlite:///./meeting_intelligence.db
DATABASE_URL=sqlite+aiosqlite:///./meeting_intelligence.db

# Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-meeting-intelligence-2026
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# AI Provider Configuration (options: mock, gemini, openai, anthropic)
# Default 'mock' generates realistic, deterministic structured intelligence immediately without requiring API keys
AI_PROVIDER=mock

# Cloud AI Provider Keys (uncomment and supply if using live cloud models)
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Storage Configuration (options: local, s3)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
# S3 / MinIO Configuration (if STORAGE_TYPE=s3)
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=meeting-recordings
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1

# Upload Limits (in bytes, default 500MB)
MAX_UPLOAD_SIZE=524288000
