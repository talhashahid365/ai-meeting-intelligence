# AI Meeting Intelligence System - Environment Configuration

# Database (PostgreSQL with pgvector for production, SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./meeting_intelligence.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meeting_intelligence

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-meeting-intelligence-2026
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# AI Provider ("mock", "gemini", "openai", "anthropic")
AI_PROVIDER=mock

# AI Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Storage Configuration ("local" or "s3")
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# S3 Compatible Storage (MinIO, AWS S3, Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=meeting-recordings
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Upload Limits (500 MB)
MAX_UPLOAD_SIZE=524288000
